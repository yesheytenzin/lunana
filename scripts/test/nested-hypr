#!/usr/bin/env bash
# nested-hypr — nested Hyprland + fixture-home + shell test harness for lunana.
#
# Proves each surface renders and behaves without touching the operator's live
# Omarchy session. A nested Hyprland compositor opens as a window on the live
# session (Wayland backend); a fixture HOME seeds a minimal Omarchy config
# (shell.json + hypr/*.lua) with the lunana suite installed into it.
#
# Usage:
#   nested-hypr up [--size WxH] [--scale S] [--monitors N]
#   nested-hypr install                       # lunana-suite install into the fixture
#   nested-hypr restart                       # restart only the nested shell
#   nested-hypr drive <ipc...>                # omarchy-shell ... / hyprctl dispatch, inside the fixture
#   nested-hypr shot <name>                   # grim the nested output -> /tmp/lunana-nested/shots/<name>.png
#   nested-hypr logs                          # QML errors/warnings from the nested shell log
#   nested-hypr down                           # exit the nested compositor, drop the fixture
#
# State: /tmp/lunana-nested/env (sig, wayland socket, fixture paths).
# hyprctl goes through `hyprctl -i <sig>` and omarchy-shell through
# WAYLAND_DISPLAY=<nested socket> so neither ever hits the live session.
# LUNANA_FIXTURE=1 keeps the suite's enable/disable hermetic (the
# omarchy-plugin-* tools drive the live shell over IPC and ignore
# XDG_CONFIG_HOME).

set -euo pipefail

STATE_DIR="/tmp/lunana-nested"
ENV_FILE="$STATE_DIR/env"
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

need() { command -v "$1" >/dev/null 2>&1 || { echo "nested-hypr: missing $1" >&2; exit 1; }; }

load_env() {
    # shellcheck disable=SC1090
    [ -f "$ENV_FILE" ] || { echo "nested-hypr: no session (run 'nested-hypr up')" >&2; exit 1; }
    . "$ENV_FILE"
}

# Env addressing the nested session (never the live one).
nested_env() {
    export HOME="$NESTED_FIXTURE"
    export XDG_CONFIG_HOME="$NESTED_FIXTURE/.config"
    # Scope every other XDG dir into the fixture too: the vendored pipeline
    # scripts (switchwall, weather cache, gamemode state) resolve them, and
    # inherited live values would leak nest writes into the live session.
    export XDG_CACHE_HOME="$NESTED_FIXTURE/.cache"
    export XDG_STATE_HOME="$NESTED_FIXTURE/.local/state"
    export XDG_DATA_HOME="$NESTED_FIXTURE/.local/share"
    export XDG_RUNTIME_DIR="$NESTED_RUNTIME"
    export WAYLAND_DISPLAY="$NESTED_WAYLAND"
    export HYPRLAND_INSTANCE_SIGNATURE="$NESTED_SIG"
    export OMARCHY_PATH="$NESTED_OMARCHY"
    export LUNANA_FIXTURE=1
    # Test-only passthrough (never set outside the nest): when
    # LUNANA_TEST_PAM_UNLOCK=1 is present in the operator's environment, the
    # nested shell inherits it so the vendored lock can authenticate against
    # its fixture-local permissive PAM service instead of the system stack.
    # This is the only way to exercise the PAM-success unlock path without
    # real credentials or /etc changes.
    if [ "${LUNANA_TEST_PAM_UNLOCK:-}" = "1" ]; then
        export LUNANA_TEST_PAM_UNLOCK=1
    fi
}

nested_hyprctl() {
    env XDG_RUNTIME_DIR="$NESTED_RUNTIME" hyprctl -i "$NESTED_SIG" "$@"
}

shell_pid_valid() {
    [ -f "$STATE_DIR/shell.pid" ] || return 1
    local pid
    pid=$(cat "$STATE_DIR/shell.pid")
    kill -0 "$pid" 2>/dev/null || return 1
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
        | grep -Fxq "HOME=$NESTED_FIXTURE" || return 1
    tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
        | grep -Fxq "OMARCHY_PATH=$NESTED_OMARCHY"
}

stop_nested_shell() {
    if shell_pid_valid; then
        local pid
        pid=$(cat "$STATE_DIR/shell.pid")
        kill "$pid" 2>/dev/null || true
        for _ in $(seq 1 50); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        echo "nested-hypr: stopped nested shell ($pid)"
    fi
    rm -f "$STATE_DIR/shell.pid" "$STATE_DIR/shell-log-path"
}

discover_shell_log() {
    local pid="$1" target=""
    for _ in $(seq 1 100); do
        for fd in "/proc/$pid/fd"/*; do
            target=$(readlink "$fd" 2>/dev/null || true)
            case "$target" in
                *"/log.qslog")
                    printf '%s\n' "$target" > "$STATE_DIR/shell-log-path"
                    return 0
                    ;;
            esac
        done
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    echo "nested-hypr: could not locate Quickshell runtime log for pid $pid" >&2
    return 1
}

start_nested_shell() {
    nested_env
    : > "$STATE_DIR/shell-launcher.log"
    nohup quickshell -p "$NESTED_OMARCHY/shell" \
        >>"$STATE_DIR/shell-launcher.log" 2>&1 &
    local pid=$!
    printf '%s\n' "$pid" > "$STATE_DIR/shell.pid"
    shell_pid_valid || {
        echo "nested-hypr: nested shell failed to start" >&2
        return 1
    }
    discover_shell_log "$pid"
    echo "nested-hypr: shell started ($pid); waiting for IPC..."
    wait_nested_ipc
    echo "nested-hypr: nested shell IPC ready"
}

cmd_up() {
    need Hyprland; need quickshell; need omarchy-shell; need jq
    local size="1920x1080" scale="1" monitors="1"
    while [ $# -gt 0 ]; do
        case "$1" in
            --size) size="$2"; shift 2 ;;
            --scale) scale="$2"; shift 2 ;;
            --monitors) monitors="$2"; shift 2 ;;
            *) echo "nested-hypr up [--size WxH] [--scale S] [--monitors N]" >&2; exit 2 ;;
        esac
    done
    [[ "$monitors" =~ ^[1-9][0-9]*$ ]] \
        || { echo "nested-hypr: --monitors must be a positive integer" >&2; exit 2; }
    [ ! -f "$ENV_FILE" ] \
        || { echo "nested-hypr: session already exists (run 'nested-hypr down')" >&2; exit 1; }
    [ -n "${OMARCHY_PATH:-}" ] || { echo "nested-hypr: OMARCHY_PATH is not set" >&2; exit 1; }
    [ -f "$OMARCHY_PATH/shell/shell.qml" ] || { echo "nested-hypr: no shell at $OMARCHY_PATH/shell" >&2; exit 1; }
    mkdir -p "$STATE_DIR/shots"
    local fixture="$STATE_DIR/fixture-home"
    local nested_omarchy="$STATE_DIR/omarchy"
    # Hyprland embeds the runtime path plus its long instance signature in a
    # Unix socket path. Keep this base short enough for the 108-byte limit.
    local nested_runtime="/tmp/lunana-rt"
    rm -rf "$fixture"
    rm -rf "$nested_omarchy" "$nested_runtime"
    mkdir -p "$fixture/.config/omarchy/plugins" "$fixture/.config/hypr" \
        "$nested_omarchy" "$nested_runtime"
    chmod 700 "$nested_runtime"
    local parent_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    # PipeWire/Pulse clients resolve their sockets through XDG_RUNTIME_DIR.
    # Link the host's sockets into the nested runtime so the audio integrations
    # exercise the real stack instead of failing to connect. Symlinks only;
    # the host session keeps ownership of the sockets.
    for sock in pipewire-0 pipewire-0-manager pulse; do
        [ -e "$parent_runtime/$sock" ] || continue
        ln -s "$parent_runtime/$sock" "$nested_runtime/$sock"
    done

    cp -a "$OMARCHY_PATH/shell" "$nested_omarchy/shell"
    for source in "$OMARCHY_PATH"/*; do
        [ "${source##*/}" = "shell" ] && continue
        ln -s "$source" "$nested_omarchy/${source##*/}"
    done

    # Minimal Omarchy config: stock bar, deterministic geometry/locale/fonts.
    # `version: 1` is required — the host treats a versionless shell.json as
    # unreadable and ignores bar.id/plugins. Host idle/lock/screensaver are
    # off: there is no unlock path in the nest (no logind/PAM), and an idle
    # lock would wedge verification behind the crashed-lockscreen screen.
    cat > "$fixture/.config/omarchy/shell.json" <<'EOF'
{
  "version": 1,
  "bar": {},
  "theme": "lunana-test",
  "locale": "en_US.UTF-8",
  "idle": {
    "screensaver": 0,
    "lock": 0
  }
}
EOF
    # Same for inir's own swayidle path (vendored Idle service): zero the
    # timeouts so no lock/DPMS command ever fires in the nest. inir's Config
    # lives at ~/.config/illogical-impulse/config.json (not ~/.config/inir/).
    mkdir -p "$fixture/.config/illogical-impulse"
    cat > "$fixture/.config/illogical-impulse/config.json" <<'EOF'
{
  "idle": {
    "screenOffTimeout": 0,
    "lockTimeout": 0,
    "suspendTimeout": 0
  }
}
EOF
    cat > "$fixture/.config/hypr/hyprland.lua" <<EOF
hl.monitor({ output = "", mode = "${size}@60", position = "auto", scale = ${scale} })
EOF
    touch "$fixture/.config/hypr/bindings.lua"

    local parent_display="${WAYLAND_DISPLAY:-wayland-0}"
    case "$parent_display" in
        /*) ;;
        *) parent_display="$parent_runtime/$parent_display" ;;
    esac
    : > "$STATE_DIR/hypr.log"
    nohup env XDG_RUNTIME_DIR="$nested_runtime" WAYLAND_DISPLAY="$parent_display" \
        Hyprland --config "$fixture/.config/hypr/hyprland.lua" \
        >"$STATE_DIR/hypr.log" 2>&1 &
    echo $! > "$STATE_DIR/hypr.pid"
    local wayland="" sig=""
    for _ in $(seq 1 150); do
        sig=$(ls -t "$nested_runtime/hypr" 2>/dev/null | head -n 1 || true)
        for sock in "$nested_runtime"/wayland-[0-9]*; do
            case "$sock" in *.lock) continue;; esac
            [ -e "$sock" ] || continue
            wayland="${sock##*/}" && break
        done
        [ -n "$wayland" ] && [ -n "${sig:-}" ] && break
        sleep 0.4
    done
    [ -n "${sig:-}" ] || { echo "nested-hypr: nested instance never registered" >&2; exit 1; }
    [ -n "$wayland" ] || { echo "nested-hypr: nested Wayland socket never appeared" >&2; exit 1; }
    cat > "$ENV_FILE" <<EOF
NESTED_SIG=$sig
NESTED_WAYLAND=$wayland
NESTED_FIXTURE=$fixture
NESTED_SIZE=$size
NESTED_OMARCHY=$nested_omarchy
NESTED_RUNTIME=$nested_runtime
EOF
    load_env
    local monitors_json=""
    for _ in $(seq 1 150); do
        monitors_json=$(nested_hyprctl monitors -j 2>/dev/null || true)
        if jq -e 'type == "array" and length > 0' >/dev/null 2>&1 <<<"$monitors_json"; then
            break
        fi
        sleep 0.1
    done
    jq -e 'type == "array" and length > 0' >/dev/null 2>&1 <<<"$monitors_json" \
        || { echo "nested-hypr: compositor IPC never became ready" >&2; exit 1; }
    local current_count
    current_count=$(jq 'length' <<<"$monitors_json")
    while [ "$current_count" -lt "$monitors" ]; do
        local before new_output=""
        before=$(nested_hyprctl monitors -j | jq -r '.[].name')
        nested_hyprctl output create headless >/dev/null
        for _ in $(seq 1 50); do
            new_output=$(nested_hyprctl monitors -j | jq -r '.[].name' \
                | grep -Fvx -f <(printf '%s\n' "$before") | head -n 1 || true)
            [ -n "$new_output" ] && break
            sleep 0.1
        done
        [ -n "$new_output" ] \
            || { echo "nested-hypr: headless output did not appear" >&2; exit 1; }
        nested_hyprctl eval \
            "hl.monitor({ output = \"$new_output\", mode = \"${size}@60\", position = \"auto\", scale = ${scale} })" \
            >/dev/null
        current_count=$(nested_hyprctl monitors -j | jq 'length')
    done
    [ "$current_count" -eq "$monitors" ] \
        || { echo "nested-hypr: expected $monitors monitors, found $current_count" >&2; exit 1; }
    start_nested_shell
    echo "nested-hypr: up (sig=$sig display=$wayland size=$size monitors=$monitors fixture=$fixture)"
}

# Block until the nested shell answers IPC. NOTE: `omarchy-shell -q`
# is quiet best-effort — it exits 0 even when nothing answers — so probes
# must use the loud form and match the reply.
wait_nested_ipc() {
    for _ in $(seq 1 150); do
        out=$(omarchy-shell shell ping 2>&1 || true)
        case "$out" in
            *"not responding"|*"not running"|"") sleep 2 ;;
            *) return 0 ;;
        esac
    done
    echo "nested-hypr: nested shell never answered" >&2
    return 1
}

cmd_install() {
    need omarchy-shell
    load_env
    nested_env
    python3 "$REPO_ROOT/scripts/lunana-suite" install --yes
    stop_nested_shell
    start_nested_shell
}

cmd_drive() {
    need omarchy-shell
    load_env
    nested_env
    case "${1:-}" in
        dispatch) nested_hyprctl "$@" ;;
        shell|lunana.*|omarchy.*) omarchy-shell "$@" ;;
        *) nested_hyprctl dispatch "$@" ;;
    esac
}

cmd_shot() {
    need grim
    load_env
    nested_env
    local name="${1:-shot-$(date +%s)}"
    grim "$STATE_DIR/shots/$name.png"
    echo "nested-hypr: shot -> $STATE_DIR/shots/$name.png"
}

cmd_logs() {
    load_env
    if [ -s "$STATE_DIR/shell-log-path" ]; then
        quickshell log --no-color --tail 200 "$(cat "$STATE_DIR/shell-log-path")" 2>/dev/null \
            | grep -iE "qml|error|warning|failed|SKIP" \
            | grep -viE "0 errors|0 warnings" | tail -n 50 || true
    elif [ -f "$STATE_DIR/shell-launcher.log" ]; then
        cat "$STATE_DIR/shell-launcher.log"
    fi
    echo "--- (new QML errors/warnings above; empty means clean) ---"
}

cmd_down() {
    load_env
    stop_nested_shell
    # Hyprland 0.56 with a Lua config no longer accepts the legacy
    # `dispatch exit`; killing the compositor is the portable stop path.
    kill "$(cat "$STATE_DIR/hypr.pid")" 2>/dev/null || true
    for _ in $(seq 1 50); do
        kill -0 "$(cat "$STATE_DIR/hypr.pid")" 2>/dev/null || break
        sleep 0.1
    done
    rm -rf "$NESTED_FIXTURE" "$NESTED_OMARCHY" "$NESTED_RUNTIME" \
        "$ENV_FILE" "$STATE_DIR/hypr.pid"
    # Shots and launcher logs stay under /tmp/lunana-nested as evidence.
    echo "nested-hypr: down"
}

cmd_restart() {
    # kind:bar and kind:service plugins only (re)load on a full shell
    # restart — the host hot-reloads other plugins on save but reuses the
    # running bar/service instances, so edits (and first-load failures)
    # stick until restart. Never touches the live shell: this kills and
    # relaunches only the nested quickshell.
    need omarchy-shell
    load_env
    nested_env
    stop_nested_shell
    start_nested_shell
}

case "${1:-}" in
    up) shift; cmd_up "$@" ;;
    install) cmd_install ;;
    restart) cmd_restart ;;
    drive) shift; cmd_drive "$@" ;;
    shot) shift; cmd_shot "$@" ;;
    logs) cmd_logs ;;
    down) cmd_down ;;
    *) echo "usage: nested-hypr {up|install|restart|drive|shot|logs|down}" >&2; exit 2 ;;
esac
