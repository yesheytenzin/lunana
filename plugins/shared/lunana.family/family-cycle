#!/usr/bin/env python3
"""family-cycle — switch the live bar-family set for the Lunana suite.

One step of the ii -> waffle -> iris family UX: select the family's bar host
(shell.json -> bar.id; absent id means the stock omarchy.bar), ensure exactly
that family's owned set is enabled, and record the choice in
shell.json -> lunana.family. lunana.state mirrors that into the vendored
Config's panelFamily, which is what the vendored panels gate on. The state
service itself is deliberately untouched — it is shared. Every family owns
its own dock/lock/background/osd, so exactly one of each is active.

Usage:  family-cycle cycle   # advance to the next installed family, print it
        family-cycle status  # print the current family, change nothing

Safety rails (same as scripts/lunana-suite): desktop user only, never
pacman/sudo, never touches /usr/share/omarchy, backs up shell.json, writes it
atomically, refuses on malformed shell.json.

Family table: a new bar family plugs in as ONE line here (plus its bar host
plugin dir). Entries whose bar plugin is not installed are skipped, so a
half-added family can never strand the session on a missing bar.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# Coherence rule: exactly one family is fully active at a time. ii and iris
# share the lunana.bar host (it stays installed throughout); while iris is
# active the bar stands itself down (lunana.bar yields whenever lunana.iris
# is enabled — see lunana.bar/Bar.qml) so the island alone owns the top edge;
# the ii dock likewise yields to lunana.iris-dock (see lunana.dock/Dock.qml).
# (family name, bar plugin id ["" = stock omarchy.bar], owned plugin ids)
FAMILIES = [
    ("ii", "lunana.bar",
     ["lunana.dock",
      "lunana.sidebar-left", "lunana.sidebar-right",
      "lunana.overview", "lunana.control-center", "lunana.background",
      "lunana.lock", "lunana.osd", "lunana.cheatsheet",
      "lunana.notifications", "lunana.wallpaper", "lunana.region",
      "lunana.session", "lunana.mascot", "lunana.altswitcher",
      "lunana.tiling", "lunana.closeconfirm", "lunana.settings"]),
    ("waffle", "lunana.bar-waffle",
     ["lunana.waffle-start", "lunana.waffle-action",
      "lunana.waffle-notifications", "lunana.waffle-lock",
      "lunana.waffle-osd", "lunana.waffle-background"]),
    ("iris", "lunana.bar",
     ["lunana.iris",
      "lunana.iris-background", "lunana.iris-palette",
      "lunana.iris-control", "lunana.iris-orbit", "lunana.iris-stage",
      "lunana.iris-dock", "lunana.iris-edit", "lunana.iris-lock",
      "lunana.iris-notifications", "lunana.iris-settings",
      "lunana.iris-osd", "lunana.iris-session", "lunana.iris-wallpaper",
      "lunana.iris-sidebar-left", "lunana.iris-sidebar-right",
      "lunana.iris-reservations"]),
    ("stock", "", []),
]

# Plugins shared across families — never enabled/disabled here. The state
# service and the family switcher itself are always on; every family owns its
# own dock/lock/background/osd, so exactly one of each is active at a time.
SHARED = {"lunana.state", "lunana.family"}


def fail(msg: str) -> "NoReturn":  # type: ignore[valid-type]
    print(f"family-cycle: {msg}", file=sys.stderr)
    raise SystemExit(1)


def info(msg: str) -> None:
    print(f"family-cycle: {msg}")


def warn(msg: str) -> None:
    print(f"family-cycle: WARNING: {msg}", file=sys.stderr)


def using_fixture() -> bool:
    """True in the nested harness or under test: the omarchy-plugin-* tools
    drive the LIVE shell over IPC and ignore XDG_CONFIG_HOME, so fixture work
    must stay in shell.json and never touch the live shell. (XDG_CONFIG_HOME
    alone cannot signal a fixture: the harness redirects HOME alongside it,
    keeping the pair self-consistent.)"""
    if os.environ.get("LUNANA_FIXTURE") == "1":
        return True
    return config_home() != Path.home() / ".config"


def ensure_shared_runtime() -> None:
    """Best-effort: make sure the SHARED services (lunana.state, lunana.family)
    are enabled in the live shell's runtime registry, not just listed in
    shell.json. The two can drift (e.g. a stand-down that only touched one of
    them), and every family's overlays silently degrade without the state
    mirror — orbit/altswitcher show nothing. Skipped in fixtures."""
    if using_fixture():
        return
    tool = shutil.which("omarchy-plugin-enable")
    if not tool:
        warn("omarchy-plugin-enable not on PATH; cannot verify shared services")
        return
    for pid in sorted(SHARED):
        try:
            proc = subprocess.run([tool, pid], check=False,
                                  capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError) as exc:
            warn(f"could not ensure {pid} enabled ({exc})")
            continue
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout or "").strip().splitlines()
            warn(f"could not ensure {pid} enabled: {err[-1] if err else 'rc!=0'}")
        else:
            info(f"shared service {pid} enabled")


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def shell_json_path() -> Path:
    return config_home() / "omarchy" / "shell.json"


def plugin_dir() -> Path:
    return config_home() / "omarchy" / "plugins"


def read_shell() -> dict:
    path = shell_json_path()
    if not path.exists():
        fail(f"{path} not found; is Omarchy installed?")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"{path} is unreadable ({exc}); fix it before switching")
    if not isinstance(data, dict):
        fail(f"{path} is not a JSON object")
    return data


def write_shell(data: dict) -> None:
    path = shell_json_path()
    backup = path.with_name(f"shell.json.lunana-family-backup-{int(time.time())}")
    shutil.copy2(path, backup)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".lunana-family-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, ensure_ascii=False)
            handle.write("\n")
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)
    info(f"backed up shell.json -> {backup.name}")


def installed_families() -> list:
    """Families whose bar host is available (stock is always available)."""
    have = {p.name for p in plugin_dir().iterdir() if p.is_dir()} if plugin_dir().is_dir() else set()
    return [f for f in FAMILIES if f[1] == "" or f[1] in have]


def enabled_ids(shell: dict) -> set:
    plugins = shell.get("plugins", [])
    if not isinstance(plugins, list):
        fail("shell.json 'plugins' is not an array; fix it before switching")
    return {e.get("id") for e in plugins if isinstance(e, dict)}


def current_family(shell: dict) -> tuple:
    bar = shell.get("bar")
    if not isinstance(bar, dict):
        fail("shell.json 'bar' is not an object; fix it before switching")
    bar_id = bar.get("id", "")
    have = enabled_ids(shell)
    cands = [f for f in installed_families() if f[1] == bar_id]
    if not cands:
        return ("stock", "", [])
    # The bar host alone cannot tell ii from iris (shared host): prefer the
    # family whose full owned set is enabled; fall back to the first bar
    # match for mixed states so the next cycle still converges to coherence.
    for fam in cands:
        if set(fam[2]) <= have:
            return fam
    return cands[0]


def apply_family(shell: dict, fam: tuple) -> None:
    name, bar_id, owned = fam
    bar = shell.setdefault("bar", {})
    if bar_id:
        bar["id"] = bar_id
    else:
        bar.pop("id", None)
    # lunana.state reads this subtree to keep the vendored Config's
    # panelFamily in step with the enabled set (the vendored tree cannot see
    # shell.json's bar.id on its own).
    lunana = shell.setdefault("lunana", {})
    if not isinstance(lunana, dict):
        fail("shell.json 'lunana' is not an object; fix it before switching")
    lunana["family"] = name
    # Enable exactly this family's owned set; disable the other families'.
    # Shared services are never touched. Bar hosts are selected via bar.id,
    # so the enabled set only carries the non-bar members.
    all_owned = {o for f in FAMILIES for o in f[2]} - SHARED
    plugins = shell.setdefault("plugins", [])
    if not isinstance(plugins, list):
        fail("shell.json 'plugins' is not an array; fix it before switching")
    have = [e.get("id") for e in plugins if isinstance(e, dict)]
    for oid in sorted(all_owned):
        if oid in owned and oid not in have:
            plugins.append({"id": oid})
        elif oid not in owned and oid in have:
            plugins[:] = [e for e in plugins
                          if not (isinstance(e, dict) and e.get("id") == oid)]
    write_shell(shell)
    ensure_shared_runtime()
    info(f"family -> {name} (bar: {bar_id or 'omarchy.bar (stock)'})")


def main(argv: list) -> int:
    if len(argv) != 2 or argv[1] not in ("cycle", "status"):
        print(__doc__.strip().splitlines()[0])
        print("usage: family-cycle [cycle|status]")
        return 2
    shell = read_shell()
    fams = installed_families()
    cur = current_family(shell)
    if argv[1] == "status":
        print(f"family: {cur[0]} (bar: {cur[1] or 'omarchy.bar (stock)'})")
        return 0
    nxt = fams[(fams.index(cur) + 1) % len(fams)] if cur in fams else fams[0]
    apply_family(shell, nxt)
    print(f"family: {nxt[0]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
