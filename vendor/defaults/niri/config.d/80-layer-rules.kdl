// ─────────────────────────────────────────────────────────────────────────────
// 80 — Layer rules
// ─────────────────────────────────────────────────────────────────────────────
// Docs: https://niri-wm.github.io/niri/Configuration:-Layer-Rules
//
// Layer-shell surfaces are used by bars, panels, wallpaper renderers, and
// overlays. Lunana uses them for its backdrop wallpaper surfaces.
//
// place-within-backdrop = true tells Niri to render the surface behind
// windows but above the compositor background, so Lunana's wallpaper shows
// between the desktop background color and the tiled windows.
// ─────────────────────────────────────────────────────────────────────────────

// Lunana "drift" family backdrop (wallpaper surface).
layer-rule {
    match namespace="quickshell:driftBackdrop"
    place-within-backdrop true
    opacity 1.0
}

// Lunana "slate" family backdrop (wallpaper surface).
layer-rule {
    match namespace="quickshell:wBackdrop"
    place-within-backdrop true
    opacity 1.0
}

// Atoll surfaces. With Atoll glass set to Blur they ask Niri to blur what is
// below them; xray off makes that the windows, not only the wallpaper.
layer-rule {
    match namespace="^quickshell:atoll-"
    background-effect {
        xray false
    }
}

// ── Examples ────────────────────────────────────────────────────────────────
// Make a specific layer surface semi-transparent:
// layer-rule {
//     match namespace="waybar"
//     opacity 0.9
// }
//
// Block a layer surface from screen capture:
// layer-rule {
//     match namespace="some-private-overlay"
//     block-out-from "screencast"
// }
